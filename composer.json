{
    "name": "juhasev/laravel-ses",
    "description": "Allows you to track opens, deliveries, bounces, complaints and clicked links when sending emails through Laravel and Amazon SES",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "Laravel",
        "SES",
        "Amazon",
        "AWS",
        "Email",
        "Amazon Simple Email Service",
        "Email Marketing",
        "Email Tracking"
    ],
    "authors": [
        {
            "name": "Oliver Eady",
            "email": "oliveready7@gmail.com"
        },
        {
            "name": "Juha Vehnia",
            "email": "juha.vehnia@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.23.0",
        "aws/aws-sdk-php": "^3.288.0",
        "ramsey/uuid": "^4.3",
        "guzzlehttp/guzzle": "^7.8.2 || ^8.0",
        "aws/aws-php-sns-message-validator": "^1.7",
        "symfony/psr-http-message-bridge": "^7.0 || ^8.0",
        "nyholm/psr7": "^1.0",
        "voku/simple_html_dom": "^4.8"
    },
    "require-dev": {
        "mockery/mockery": "^1.0",
        "orchestra/testbench": "^11.2",
        "phpunit/phpunit": "^11.5.50 || ^12.5.8 || ^13.0.3",
        "ext-json": "*",
        "larastan/larastan": "^3.11",
        "nunomaduro/collision": "^8.9.5"
    },
    "autoload": {
        "psr-4": {
            "Juhasev\\LaravelSes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Juhasev\\LaravelSes\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html build/coverage --coverage-text=build/coverage.txt --coverage-clover build/logs/clover.xml"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Juhasev\\LaravelSes\\LaravelSesServiceProvider"
            ],
            "aliases": {
                "SesMail": "Juhasev\\LaravelSes\\Facades\\SesMail"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "phpunit/phpunit": true
        },
        "policy": {
            "malware": {
                "block": true,
                "block-scope": "all"
            },
            "advisories": {
                "block": true
            },
            "abandoned": {
                "audit": "report"
            }
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
